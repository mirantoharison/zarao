{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zarao",
  "version": "2.0.0",
  "identifier": "mg.zarao.app",
  "build": {
    "beforeDevCommand": "npm run bundle-node && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run bundle-node && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Zarao",
        "width": 1100,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../server/": "server/",
      "resources/ffmpeg/": "ffmpeg/",
      "resources/node/": "node/"
    }
  }
}